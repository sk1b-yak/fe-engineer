{
  "name": "fe-engineer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Front-end engineer AI agent (Cloudflare Agents SDK) with built-in Biome linting and a UI wiring audit.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit --project client/tsconfig.json",
    "build:client": "vite build",
    "build": "npm run build:client",
    "test:audit": "node --experimental-strip-types scripts/test-audit.ts",
    "test:lint": "node --experimental-strip-types scripts/test-lint.ts",
    "test": "npm run test:audit && npm run test:lint"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.280",
    "@babel/parser": "^7.26.7",
    "@babel/types": "^7.26.7",
    "@biomejs/js-api": "^0.7.1",
    "@biomejs/wasm-bundler": "^1.9.4",
    "@biomejs/wasm-web": "^1.9.4",
    "@cloudflare/ai-chat": "^0.7.1",
    "@cloudflare/codemode": "^0.3.7",
    "agents": "^0.13.1",
    "ai": "^6.0.277",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/wasm-nodejs": "^1.9.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer": "^25.0.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.2",
    "wrangler": "^4.0.0"
  }
}
